{
  "name": "jscpd",
  "version": "5.1.0",
  "description": "Copy/paste detector for programming source code. Finds duplicated code in 223 languages, reports as HTML/JSON/SARIF/Markdown, fails CI over a duplication threshold. Rust engine, 24-37x faster than v4 (TypeScript version: jscpd@4.x).",
  "homepage": "https://jscpd.dev",
  "bin": {
    "jscpd": "./run-jscpd.js"
  },
  "files": [
    "run-jscpd.js",
    "platform-map.js"
  ],
  "optionalDependencies": {
    "jscpd-linux-x64-gnu": "5.0.16",
    "jscpd-linux-arm64-gnu": "5.0.16",
    "jscpd-linux-x64-musl": "5.0.16",
    "jscpd-darwin-arm64": "5.0.16",
    "jscpd-darwin-x64": "5.0.16",
    "jscpd-windows-x64-msvc": "5.0.16",
    "jscpd-windows-arm64-msvc": "5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucherenko/jscpd.git",
    "directory": "rust/jscpd"
  },
  "keywords": [
    "jscpd",
    "cpd",
    "copy-paste-detector",
    "duplicate",
    "duplicate-code",
    "code-duplication",
    "duplication",
    "code-quality",
    "static-analysis",
    "dry",
    "sarif",
    "ci",
    "cli",
    "rust"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

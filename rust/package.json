{
  "name": "cpd",
  "version": "5.1.1",
  "description": "Copy/paste detector for programming source code — Rust engine, self-contained binary, installs the cpd command",
  "homepage": "https://jscpd.dev",
  "funding": "https://opencollective.com/jscpd",
  "bin": {
    "cpd": "./run-cpd.js"
  },
  "files": [
    "run-cpd.js",
    "platform-map.js"
  ],
  "optionalDependencies": {
    "jscpd-linux-x64-gnu": "5.1.1",
    "jscpd-linux-arm64-gnu": "5.1.1",
    "jscpd-linux-x64-musl": "5.1.1",
    "jscpd-linux-arm64-musl": "5.1.1",
    "jscpd-darwin-arm64": "5.1.1",
    "jscpd-darwin-x64": "5.1.1",
    "jscpd-windows-x64-msvc": "5.1.1",
    "jscpd-windows-arm64-msvc": "5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucherenko/jscpd.git",
    "directory": "rust"
  },
  "keywords": [
    "cpd",
    "copy-paste-detector",
    "duplicate",
    "jscpd",
    "code-duplication",
    "cli",
    "rust"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
